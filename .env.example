# ── Solana network ────────────────────────────────────────────────────────────
# 'devnet' | 'mainnet-beta'
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoints (use a private RPC for production)
NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com

# Demo mode — set to 'true' to enable hackathon demo flow (no real on-chain calls)
NEXT_PUBLIC_DEMO_MODE=false

# ── Database ──────────────────────────────────────────────────────────────────
#
# LOCAL DEVELOPMENT
#   Leave DATABASE_URL unset (or commented out).
#   The app uses SQLite via better-sqlite3 at the path below.
#
DB_PATH=./data/meteora-mfe.db

#
# PRODUCTION (Vercel)
#   Set DATABASE_URL to your hosted Postgres connection string.
#   Recommended provider: Neon (neon.tech) — free tier is sufficient for an MVP.
#
#   Get your connection string from:
#   Neon dashboard → your project → Connection Details → Connection string
#
#   Example format (do NOT commit real credentials):
#   DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require
#
#   Set this in Vercel: Project Settings → Environment Variables
#   Do NOT put real credentials in this file or commit them to Git.
#
# DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require
